plugin.tx_rkwcompetition {
    view {
        # cat=plugin.tx_rkwcompetition/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:rkw_competition/Resources/Private/Templates/
        # cat=plugin.tx_rkwcompetition/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:rkw_competition/Resources/Private/Partials/
        # cat=plugin.tx_rkwcompetition/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:rkw_competition/Resources/Private/Layouts/
    }
    persistence {
        # cat=plugin.tx_rkwcompetition/persistence/010; type=string; label=Default storage PID
        storagePid =
    }
    settings {

        # cat=plugin.tx_rkwcompetition/basic/010; type=int; label=Login Page ID
        loginPid =
        # cat=plugin.tx_rkwcompetition/basic/020; type=int; label=Register Page ID
        registerPid =
        mandatoryFields {
            # cat=plugin.tx_rkwcompetition/basic/030; type=string; label=Mandatory Fields Register
            register = email, firstName, lastName, institution, address, zip, city, telephone, sector, contributionTitle, remark
        }

        # cat=plugin.tx_rkwcompetition/basic/040; type=int; label=Competition Page ID
        competitionPid =
        # cat=plugin.tx_rkwcompetition/basic/050; type=int; label=Jury Page ID
        juryPid =
        mandatoryFields {
            # cat=plugin.tx_rkwcompetition/basic/060; type=string; label=Mandatory Fields Group Work
            registerGroupWork = groupWorkAuthorization, groupWorkAddPersons
        }

        api {
            ownCloud {
                # cat=plugin.tx_rkwcompetition/basic/070; type=string; label=OwnCloud - Base URL
                baseUrl =
                admin {
                    # cat=plugin.tx_rkwcompetition/basic/080; type=string; label=OwnCloud - Admin Username
                    username =
                    # cat=plugin.tx_rkwcompetition/basic/090; type=string; label=OwnCloud - Admin Password
                    password =
                }
                folderStructure {
                    # nesting folders is possible (example: rkw_competition/competition/)
                    # cat=plugin.tx_rkwcompetition/basic/100; type=string; label=OwnCloud - Base Path for Uploads
                    basePath = rkw_competition
                }

                # cat=plugin.tx_rkwcompetition/basic/110; type=string; label=Proxy
                proxy =
                # cat=plugin.tx_rkwcompetition/basic/120; type=string; label=Proxy Username
                proxyUsername =
                # cat=plugin.tx_rkwcompetition/basic/130; type=string; label=Proxy Password
                proxyPassword =
            }
        }

        upload {
            # cat=plugin.tx_rkwcompetition/basic/140; type=string; label=Allowed File Types (Extensions)
            allowedFileTypes = pdf, msword, vnd.openxmlformats-officedocument.wordprocessingml.document
            # cat=plugin.tx_rkwcompetition/basic/150; type=string; label=Upload Folder
            extensionFolder = rkw_competition
        }
    }
}
